# Example .env.sample for local Postgres development
# Replace values with your local database connection info

# Example DATABASE_URL format:
# postgres://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vision_global_empowerment

# Django settings
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
